{
  "name": "gis-parcel-extractor",
  "version": "1.0.0",
  "private": true,
  "description": "Browser extension that saves an ArcGIS parcel layer as GeoJSON, plus the install page and a signed-in parcel workspace.",
  "type": "module",
  "main": "extract-parcels.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "prisma generate && tsc -p api",
    "hash-password": "node scripts/hash-password.mjs",
    "studio": "node analyze.mjs serve",
    "test": "node --test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "@turf/area": "^7.4.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "argon2": "^0.45.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "5.9"
  }
}
